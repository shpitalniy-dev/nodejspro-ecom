PORT=3000                              # HTTP port the server listens on. Required.
LOG_LEVEL=info                         # One of debug, info, warn, error.
TIMEOUT_MS=5000                        # Timeout budget for outbound calls, in ms.
DB_HOST=pgbouncer                      # PgBouncer's compose service name (HW #15) — resolved via Docker DNS, not Postgres directly.
DB_PORT=6432                           # PgBouncer's port.
DB_NAME=ecom                           # Database name.
DB_USER=app_user                       # Postgres role the app connects as (created by database/init.sql).
DB_PASSWORD_FILE=/shared-secrets/db-password # Path to the file holding the current DB password (mounted by Compose from secrets/db_password).
DB_URL=postgresql://admin:changeme@pgbouncer:6432/ecom # Through PgBouncer (HW #15), not Postgres directly.
BROKER_URL=amqp://app:changeme@rabbitmq:5672 # AMQP (5672), not the 15672 management UI. Through the rabbitmq compose service (HW #19).
REDIS_URL=redis://127.0.0.1:6379       # Cache Redis instance (HW #23) — single-flight cache-aside over product detail.
REDIS_QUEUE_URL=redis://127.0.0.1:6380 # Queue/session Redis instance (HW #23) — noeviction, used by demo-session.ts and the rate-limit guard today, BullMQ later.
JWT_KID=k1                             # Access-token signing key id (HW #24) — a label, not a secret.
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PKCS8_PEM # base64 of the ES256 private key's PKCS#8 PEM — from the vault
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_SPKI_PEM   # base64 of the ES256 public key's SPKI PEM — from the vault
REFRESH_TOKEN_PEPPER=REPLACE_WITH_BASE64_32_RANDOM_BYTES # HMAC pepper for refresh-token hashes (HW #24) — from the vault, kept outside the DB on purpose
STORAGE_ENDPOINT=http://127.0.0.1:6600 # Garage's S3 API port (HW #26) — see docker-compose.yml's `garage` service.
STORAGE_REGION=us-east-1               # Matches garage.toml's [s3_api] s3_region. Optional, defaults to us-east-1.
STORAGE_ACCESS_KEY=REPLACE_WITH_GARAGE_KEY_ID     # Minted by scripts/garage-init.mjs — from the vault
STORAGE_SECRET_KEY=REPLACE_WITH_GARAGE_SECRET_KEY # Minted by scripts/garage-init.mjs — from the vault
STORAGE_BUCKET_UPLOADS=hw26-uploads    # Private bucket presigned PUTs target (HW #26, demo:upload).
