{
  "title": "nodejspro-ecom — RED",
  "uid": "nodejspro-ecom-red",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Rate — requests/sec by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nodejspro-ecom-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors — 5xx/sec by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nodejspro-ecom-prometheus"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duration — p95 by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nodejspro-ecom-prometheus"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
