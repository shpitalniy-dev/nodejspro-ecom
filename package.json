{
  "name": "nodejspro-ecom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:env": "node scripts/check-env-example.js",
    "contract": "node contract/check.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node build/demo-nplus1.js",
    "dev": "nodemon",
    "githooks:commit-msg": "commitlint --edit",
    "lint": "eslint ./ --max-warnings 0",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d build/data-source.js",
    "migrate:generate": "bash scripts/with-secrets.sh dev npx typeorm migration:generate -d build/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d build/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d build/data-source.js",
    "precommit": "lint-staged && npm run ts-lint",
    "prepare": "husky install",
    "report": "bash scripts/with-secrets.sh dev node build/report.js",
    "seed": "bash scripts/with-secrets.sh dev node build/seed.js",
    "start": "npm run build && node ./build/index.js",
    "test": "tsc -p tsconfig.test.json && node --test ./.test-build/test/*.test.js",
    "ts-lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "husky": "^8.0.0",
    "lint-staged": "16.2.6",
    "nodemon": "3.1.14",
    "prettier": "3.6.2",
    "sort-package-json": "3.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
